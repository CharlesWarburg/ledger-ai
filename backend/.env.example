# Application settings.
APP_NAME=Ledger AI API
ENVIRONMENT=development
LOG_LEVEL=INFO
JWT_SECRET_KEY=replace_with_at_least_32_random_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL connection used by FastAPI, SQLAlchemy, and Alembic.
DATABASE_URL=postgresql+psycopg2://ledger:change_me@localhost:5433/ledger_ai

# Local development document storage. This directory is intentionally ignored.
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# OpenAI invoice extraction. Keep this key out of version control.
OPENAI_API_KEY=
OPENAI_INVOICE_MODEL=gpt-4o-mini
